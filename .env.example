# ─────────────────────────────────────────────────────────────
# BookFlow environment variables
# Copy to .env.local (never commit .env.local) and fill in values.
# ─────────────────────────────────────────────────────────────

# ── Public (sent to the browser; NOT secret) ─────────────────
# Base URL of the app. Local: http://localhost:3000  Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL. Local stack (`npm run db:start`): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key (starts with sb_publishable_...).
# Older projects/CLI versions call this the "anon" key — either works here.
# Local: run `npx supabase status` and copy the publishable/anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server only (SECRET — never prefix with NEXT_PUBLIC_) ────
# Supabase secret key (sb_secret_...) or legacy service_role key.
# Bypasses RLS. Needed from Phase 6 (staff invites). Local: `npx supabase status`.
SUPABASE_SECRET_KEY=

# Resend API key. Needed from Phase 11 (email notifications). https://resend.com/api-keys
RESEND_API_KEY=

# Sender address on a domain verified in Resend, e.g. "BookFlow <bookings@yourdomain.com>".
EMAIL_FROM=
